# Apache / LiteSpeed Rewrite Rules for Clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure MultiViews doesn't interfere with rewrites
    Options -MultiViews

    # 1. Redirect direct requests for index.html to /
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 2. Redirect direct requests for *.html to clean URLs (301 Permanent Redirect)
    # REDIRECT_STATUS check prevents infinite loops when rewritten internally
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/([^/]+)\.html[\s?] [NC]
    RewriteRule ^([^/]+)\.html$ /%1 [R=301,L]

    # 3. Rewrite extensionless URLs to .html files internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ %{REQUEST_FILENAME}.html [L]
</IfModule>
